# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …бусад нь нууц түлхүүр агуулдаг тул ignore хэвээр, харин загвар нь
# репод байх ёстой (README нь `cp .env.example .env.local` гэж зааварладаг).
!.env.example

# Prod-оос татсан schema snapshot нь зөвхөн харьцуулах зориулалттай —
# migration эх сурвалж нь supabase/migrations/ хэвээр (scripts/schema-snapshot.ts).
/supabase/_snapshot/

# Supabase CLI-ийн түр файлууд (холбогдсон project-ийн ref г.м.)
/supabase/.temp/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/

# claude code / impeccable skill (local only)
/.claude/
/.impeccable/
/DESIGN.md
/PRODUCT.md
shot.tmp.mjs

# database backups (pnpm db:backup)
/backups

# vitest нь ESM тохиргоог ачаалахдаа үлдээдэг түр файл
vitest*.config.*.timestamp-*.mjs
