{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // `qpay/` is a standalone harness with its own tsconfig, package.json and
  // node_modules (docs/qpay-testing.md §4). Its sources are committed but its
  // dependencies are not, so leaving it in `**/*.ts` broke the deploy build on
  // `Cannot find module 'qrcode-terminal'` — a package that only ever exists
  // inside qpay/. It typechecks itself with `npm run typecheck` in that folder.
  "exclude": ["node_modules", "qpay"]
}
