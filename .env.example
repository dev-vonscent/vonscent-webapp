# ============================================================================
# vonscent.mn — орчны хувьсагчийн загвар
# ============================================================================
#
#   cp .env.example .env.local     # дараа нь утгуудыг бөглөнө
#
# ⚠️ .env.local БОЛОН бодит түлхүүр агуулсан ямар ч файлыг git-д БҮҮ оруул
#    (.gitignore-д `.env*` бий — тэр хамгаалалтыг бүү сулруул).
#
# Vercel дээр ямар scope-д тавихыг мөр бүрийн ард [SCOPE] гэж тэмдэглэв:
#
#   [P]   = зөвхөн Production
#   [Pv]  = зөвхөн Preview
#   [P+Pv]= хоёуланд нь, ГЭХДЭЭ ӨӨР утгаар
#   [ALL] = Production + Preview + Development, ижил утга
#
# Дэлгэрэнгүй: README.md → «Орчны хувьсагч ба Vercel scope».
# ============================================================================


# ─── Supabase ───────────────────────────────────────────────────────────────
# ⚠️ Production ба Preview нь ӨӨР ӨӨР Supabase project руу заана.
#    Preview-д production-ий түлхүүрийг тавьбал preview-ийн тест жинхэнэ
#    захиалга, жинхэнэ хэрэглэгчийн өгөгдлийг өөрчилнө.

# Браузерт ил гарна (NEXT_PUBLIC_). Нууц биш — RLS л хамгаалдаг.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co          # [P+Pv]
NEXT_PUBLIC_SUPABASE_ANON_KEY=                                      # [P+Pv]

# ⛔ SERVER-ONLY. RLS-ийг бүрэн тойрдог. NEXT_PUBLIC_ угтвар ХЭЗЭЭ Ч БҮҮ ӨГ,
#    client component-д БҮҮ импортло (src/lib/supabase/admin.ts-ээр л дамжина).
SUPABASE_SERVICE_ROLE_KEY=                                          # [P+Pv]

# Migration/script-д л хэрэглэгдэнэ (scripts/migrate.ts, db-backup.ts).
# Апп ажиллахад шаардлагагүй — Vercel дээр тавих ШААРДЛАГАГҮЙ.
# Нууц үгэнд тусгай тэмдэгт (%, @, /) байвал ЗААВАЛ percent-encode хий:
#   % → %25 · @ → %40 · / → %2F
DATABASE_URL=postgresql://postgres:<encoded-password>@db.<project-ref>.supabase.co:5432/postgres   # [—]

# Зургийн bucket. Өгөгдмөл нь `product-images` (0011_storage.sql үүсгэдэг).
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=product-images                  # [ALL]
# Зөвхөн script-үүд уншина (scripts/gen-note-images.ts г.м.).
SUPABASE_STORAGE_BUCKET=product-images                              # [—]


# ─── Апп ────────────────────────────────────────────────────────────────────
# Канон URL: и-мэйл дэх холбоос, OG зураг, QPay-ийн буцах хаяг бүгд эндээс.
#   Production → https://vonscent.mn
#   Preview    → Vercel-ийн өгөгдмөл preview домэйн, эсвэл хоосон орхи
#   Local      → http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000                          # [P+Pv]


# ─── Утасны баталгаажуулалт (verify.mn MO-SMS) ──────────────────────────────
# Supabase-ийн phone auth БИШ — verify.mn-ий MO-SMS (CLAUDE.md).
VERIFY_MN_API_KEY=                                                  # [P+Pv]

# 4 оронтой passcode-ийн server-side pepper. Үүнгүйгээр утасны нэвтрэлт
# бүхэлдээ идэвхгүй болно (src/lib/auth/phone.ts).
# ⚠️ Production ба Preview-д ӨӨР утга байх ёстой: ижил байвал нэг орчноос
#    гаргаж авсан нууц үгийн hash нөгөө орчинд шууд хүчинтэй болно.
AUTH_PASSCODE_PEPPER=                                               # [P+Pv]

# Rate-limit субъектын hash-ийн давс. Хоосон бол AUTH_PASSCODE_PEPPER руу
# автоматаар шилжинэ (src/lib/env.ts:29) — заавал биш.
RATE_LIMIT_SALT=                                                    # [P+Pv]


# ─── Төлбөр (QPay) ──────────────────────────────────────────────────────────
# ⚠️ Preview дээр ҮНЭХЭЭР мөнгө татах эрсдэлээс сэргийлж QPAY_MOCK=true бай.
QPAY_USERNAME=                                                      # [P]
QPAY_PASSWORD=                                                      # [P]
QPAY_INVOICE_CODE=                                                  # [P]
# "true" = mock. Credential дутуу үед автоматаар mock болно.
#   Production → false · Preview → true
QPAY_MOCK=true                                                      # [P+Pv]
# QPay-ийн API суурь хаяг. Хоосон бол код өгөгдмөлөө ашиглана.
QPAY_BASE_URL=                                                      # [P]
# Webhook буцах хаяг. Хоосон бол NEXT_PUBLIC_SITE_URL-аас гаргана.
# Preview домэйн нь deploy бүрт өөрчлөгддөг тул preview-д callback
# найдвартай ажиллахгүй — энэ нь mock ашиглах бас нэг шалтгаан.
QPAY_CALLBACK_URL=                                                  # [P]
# QPay-ийн дуудлагын бүтэн лог. Production дээр БҮҮ ас.
DEBUG_QPAY=                                                         # [Pv]
# Тестийн дүн — зөвхөн operator/super_admin-ий захиалгад үйлчилнэ.
QPAY_TEST_AMOUNT=                                                   # [Pv]
# Callback-ийн замд шигтгэх нууц сегмент: /api/payments/qpay/webhook/<нууц>.
# QPay нь callback-даа ГАРЫН ҮСЭГ ӨГДӨГГҮЙ (V2 баримтад HMAC/IP allowlist
# байхгүй) тул дуудагчийг таних цорын ганц арга нь энэ. Нууц нь QPay-д
# үүсгэсэн invoice дотор л явдаг — browser-т хэзээ ч гарахгүй.
# Тавьсан үед хуучин нууцгүй зам 404 болно; хоосон бол хуучин зам ажиллана
# (нэг мартсан env бүх төлбөрийн callback-ыг унагаах ёсгүй).
#   openssl rand -hex 32
QPAY_CALLBACK_SECRET=                                               # [P]


# ─── Cron (Vercel) ──────────────────────────────────────────────────────────
# /api/cron/reconcile-payments — нөөц дуусахын ӨМНӨХ эцсийн төлбөрийн
# шалгалт (vercel.json, 5 мин тутам). Алдагдсан QPay callback-ийг өөрөө
# олдог цорын ганц механизм: үүнгүй бол «мөнгө орсон ч захиалга цуцлагдсан»
# тохиолдол ямар ч дохиогүй өнгөрнө.
# Хоосон бол route нь өөрийгөө 503-аар хаана — нээлттэй орхивол танихгүй хүн
# QPay-ийн квотыг шатаах вектор болно.
#   openssl rand -hex 32
# ⚠️ Vercel Hobby дээр cron өдөрт нэг л удаа ажилладаг — Pro шаардлагатай.
CRON_SECRET=                                                        # [P]


# ─── И-мэйл (Resend) ────────────────────────────────────────────────────────
# ⚠️ Preview-д production-ий түлхүүрийг тавьбал тестийн захиалга ЖИНХЭНЭ
#    хэрэглэгч рүү и-мэйл илгээнэ. Preview-д хоосон орхи — илгээлт унтарна.
RESEND_API_KEY=                                                     # [P]
EMAIL_FROM=                                                         # [P]
# Холбоо барих формын захиалга ирэх хайрцаг.
STORE_INBOX_EMAIL=                                                  # [P]


# ─── Telegram (админы мэдэгдэл) ─────────────────────────────────────────────
# Preview-д хоосон орхи, эс бөгөөс тестийн захиалга бүр жинхэнэ ажилтны
# чат руу мэдэгдэл явуулна.
TELEGRAM_BOT_TOKEN=                                                 # [P]
TELEGRAM_ADMIN_CHAT_ID=                                             # [P]


# ─── OpenAI (барааны зураг үүсгэх) ──────────────────────────────────────────
# Хоосон бол AI зураг үүсгэх боломж унтарна (src/lib/env.ts:39).
# Preview-д хоосон орхивол санамсаргүй зарцуулалт гарахгүй.
OPENAI_API_KEY=                                                     # [P]
# webp чанар (1-100). Хоосон бол кодын өгөгдмөл.
IMAGE_QUALITY=                                                      # [—]


# ─── Аналитик ───────────────────────────────────────────────────────────────
# ⚠️ Preview-д ЗААВАЛ хоосон орхи — эс бөгөөс тестийн трафик production-ий
#    тайланг бохирдуулна.
NEXT_PUBLIC_GA_ID=                                                  # [P]
NEXT_PUBLIC_META_PIXEL_ID=                                          # [P]


# ─── Sentry ─────────────────────────────────────────────────────────────────
# DSN нь хоёр орчинд ижил байж болно — Sentry нь орчныг deploy-ийн
# мэдээллээр ялгадаг. Хүсвэл тусдаа project үүсгэж болно.
NEXT_PUBLIC_SENTRY_DSN=                                             # [ALL]
# Зөвхөн build үед (source map илгээх) — Vercel дээр л хэрэгтэй.
SENTRY_ORG=                                                         # [ALL]
SENTRY_PROJECT=                                                     # [ALL]


# ============================================================================
# Хуучирсан — кодод ХААНА Ч АШИГЛАГДАХГҮЙ. Шинэ орчинд бүү тавь.
# ============================================================================
# R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY / R2_BUCKET /
# R2_PUBLIC_URL — зураг Cloudflare R2 биш, Supabase Storage дээр байдаг
#                 (src/lib/storage/storage.ts). README-гийн «R2» дурдлага
#                 хуучирсан.
# DATABASE_PASS — DATABASE_URL дотор нууц үг аль хэдийн бий; энэ нэрийг
#                 кодын аль ч хэсэг уншдаггүй.
